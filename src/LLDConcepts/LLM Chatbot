### 7.5 ChatSession + SessionManager

```java
public class ChatSession {
    private final String sessionId;
    private final String userId;
    private final List<Message> messages = new ArrayList<>();
    private final ContextManager contextManager;
    private long lastActiveTime;

    public ChatSession(String sessionId, String userId, ContextManager cm) {
        this.sessionId      = sessionId;
        this.userId         = userId;
        this.contextManager = cm;
        this.lastActiveTime = System.currentTimeMillis();
    }

    public void addMessage(Message msg) {
        messages.add(msg);
        lastActiveTime = System.currentTimeMillis();
    }

    public List<Message> getOptimizedContext() {
        return contextManager.compress(messages);
    }

    public long getLastActiveTime() { return lastActiveTime; }
    public String getSessionId()    { return sessionId; }
}

// Manages all active sessions with thread-safe access
public class SessionManager {
    private final ConcurrentHashMap<String, ChatSession> sessions = new ConcurrentHashMap<>();
    private final ContextManager defaultContextManager;

    public SessionManager(ContextManager defaultCM) {
        this.defaultContextManager = defaultCM;
    }

    public ChatSession getOrCreate(String sessionId, String userId) {
        return sessions.computeIfAbsent(sessionId,
            id -> new ChatSession(id, userId, defaultContextManager));
    }

    // Evict sessions idle for more than N minutes (called periodically)
    public void evictIdle(int maxIdleMinutes) {
        long cutoff = System.currentTimeMillis() - (maxIdleMinutes * 60_000L);
        sessions.entrySet().removeIf(e -> e.getValue().getLastActiveTime() < cutoff);
    }
}
```

